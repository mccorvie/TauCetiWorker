# Semantic desired state for `tauceti workers`.
version = 1

[[workers]]
id = "worker1"
enabled = true

[[workers]]
id = "worker2"
enabled = true
agent = "codex"
only = ["rebase", "review"]
ignore_quota = true

[[workers]]
id = "worker3"
enabled = true
only = ["roadmap", "fix", "fix-ci"]
tools = ["loogle"]
roadmap_only = "RepresentationTheory"
source = "https://github.com/FormalFrontier/Etingof-RepresentationTheory-draft1"


[[workers]]
id = "worker4"
enabled = true
agent = "codex"
tools = ["loogle"]

# Semantic search arms: each name needs its service socket on the host (docs/tools.md).
[[workers]]
id = "worker5"
enabled = false
agent = "codex"
only = ["roadmap", "fix", "fix-ci"]
tools = ["finder", "explore"]
